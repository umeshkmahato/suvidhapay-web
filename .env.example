# ============================================================================
# SuvidhaPay — Environment Configuration Template (.env.example)
# ============================================================================

# Gemini AI API Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Studio App Hosting URL (injected automatically in preview)
APP_URL="http://localhost:3000"

# Application Server Settings
PORT="3000"
NODE_ENV="development"
SUVIDHAPAY_DATA_DIR="./data"

# Database Engine Selection ('POSTGRES' or 'LOKIJS')
# In Docker Compose, this defaults to 'POSTGRES'.
# In local development without Docker, it falls back to 'LOKIJS' if PostgreSQL is unreachable.
DATABASE_ENGINE="POSTGRES"

# PostgreSQL Database Configuration
DATABASE_URL="postgres://suvidhapay:suvidhapay_secret_2026@localhost:5432/suvidhapay"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="suvidhapay"
POSTGRES_USER="suvidhapay"
POSTGRES_PASSWORD="suvidhapay_secret_2026"

# Docker Host Port Mappings (Optional)
FRONTEND_HOST_PORT="80"
BACKEND_HOST_PORT="3001"
POSTGRES_HOST_PORT="5432"

# Security & JWT Tokens
JWT_ACCESS_SECRET="dev_suvidhapay_jwt_access_secret_change_in_prod"
JWT_REFRESH_SECRET="dev_suvidhapay_jwt_refresh_secret_change_in_prod"
JWT_ACCESS_EXPIRES_SEC="900"
JWT_REFRESH_EXPIRES_SEC="604800"

# CORS & Municipal Business Policies
CORS_ORIGIN="*"
ALLOW_ADVANCE_OVERPAYMENT="false"
